APP_NAME="Pondok Pesantren Terpadu Khairul Ummah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Origin of the React SPA. Used by config/cors.php so the browser is allowed to
# call this API cross-origin.
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_ALT=http://127.0.0.1:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khairul_ummah
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Seven days, kept in step with `config/sanctum.php`. The SPA authenticates with
# the session cookie, so this — not the token expiry — is what actually ends a
# browser session.
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# `lax` is correct while the SPA and the API share a site, which they do locally
# (localhost:5173 and localhost:8000 differ by port only, and SameSite ignores
# ports). If the two are ever deployed to genuinely different sites — say
# app.example.com and api.example.com — change this to `none` and serve over
# HTTPS, otherwise the browser will drop the session cookie on every XHR.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000
